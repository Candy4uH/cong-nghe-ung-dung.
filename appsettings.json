{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ObjectDetectionApi": {
    "BaseUrl": "http://localhost:5161",
    "TimeoutSeconds": 30,
    "MaxUploadBytes": 5242880,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".bmp",
      ".webp"
    ]
  },
  "AllowedHosts": "*"
}
