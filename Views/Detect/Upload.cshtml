@model DetectUploadViewModel

@{
    ViewData["Title"] = "Upload image";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h1 class="h4 mb-0">Upload image for object detection</h1>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Supported types: <strong>@Model.AllowedExtensionsDisplay</strong><br />
                    Max size: <strong>@((Model.MaxUploadBytes / 1024d / 1024d).ToString("0.##")) MB</strong>
                </p>

                <form asp-controller="Detect" asp-action="Upload" method="post" enctype="multipart/form-data" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Image" class="form-label">Image file</label>
                        <input asp-for="Image" class="form-control" type="file" accept=".jpg,.jpeg,.png,.bmp,.webp,image/jpeg,image/png,image/bmp,image/webp" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Run detection</button>
                        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
