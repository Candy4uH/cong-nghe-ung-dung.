@model HomeIndexViewModel

@{
    ViewData["Title"] = "Object Detection Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Object Detection Dashboard</h1>
        <p class="text-muted mb-1">Monitor API readiness and model metadata before running detections.</p>
        <p class="small mb-0">
            <span class="badge text-bg-primary me-2">Internal API</span>
            Health, model info, and image detection are loaded from your `Object-Detection.Api` backend.
            <span class="badge text-bg-success ms-3 me-2">Third-party API</span>
            Fruit nutrition cards below are loaded from the public Fruityvice API.
        </p>
    </div>
    <a class="btn btn-primary" asp-controller="Detect" asp-action="Upload">Upload image for detection</a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">API Health</h2>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.HealthErrorMessage))
                {
                    <div class="alert alert-warning mb-0">@Model.HealthErrorMessage</div>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@(Model.HealthStatus ?? "N/A")</dd>

                        <dt class="col-sm-4">Message</dt>
                        <dd class="col-sm-8">@(Model.HealthMessage ?? "N/A")</dd>

                        <dt class="col-sm-4">Timestamp</dt>
                        <dd class="col-sm-8">
                            @(Model.HealthTimestamp?.ToString("u") ?? "N/A")
                        </dd>
                    </dl>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Model Info</h2>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ModelInfoErrorMessage))
                {
                    <div class="alert alert-warning mb-0">@Model.ModelInfoErrorMessage</div>
                }
                else
                {
                    <dl class="row">
                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">@(Model.ModelName ?? "N/A")</dd>

                        <dt class="col-sm-4">Version</dt>
                        <dd class="col-sm-8">@(Model.ModelVersion ?? "N/A")</dd>

                        <dt class="col-sm-4">Framework</dt>
                        <dd class="col-sm-8">@(Model.ModelFramework ?? "N/A")</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@(Model.ModelDescription ?? "N/A")</dd>

                        <dt class="col-sm-4">Labels</dt>
                        <dd class="col-sm-8">
                            @if (Model.Labels.Count == 0)
                            {
                                <span>N/A</span>
                            }
                            else
                            {
                                <span>@string.Join(", ", Model.Labels)</span>
                            }
                        </dd>
                    </dl>

                    @if (Model.AdditionalModelInfo.Count > 0)
                    {
                        <h3 class="h6 mt-4">Additional fields</h3>
                        <ul class="mb-0">
                            @foreach (var field in Model.AdditionalModelInfo)
                            {
                                <li><strong>@field.Key:</strong> @field.Value</li>
                            }
                        </ul>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
                <div>
                    <h2 class="h5 mb-0">External Fruit API</h2>
                </div>
                <small class="text-muted">Source: Fruityvice public API</small>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ExternalFruitApiErrorMessage))
                {
                    <div class="alert alert-warning mb-0">@Model.ExternalFruitApiErrorMessage</div>
                }
                else if (Model.FeaturedFruits.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">No fruit records were loaded from the external API.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var fruit in Model.FeaturedFruits)
                        {
                            <div class="col-md-4">
                                <div class="border rounded p-3 h-100">
                                    <h3 class="h6 mb-3 text-capitalize">@fruit.Name</h3>
                                    <dl class="row mb-0 small">
                                        <dt class="col-6">Family</dt>
                                        <dd class="col-6">@(fruit.Family ?? "N/A")</dd>

                                        <dt class="col-6">Order</dt>
                                        <dd class="col-6">@(fruit.Order ?? "N/A")</dd>

                                        <dt class="col-6">Genus</dt>
                                        <dd class="col-6">@(fruit.Genus ?? "N/A")</dd>

                                        <dt class="col-6">Calories</dt>
                                        <dd class="col-6">@fruit.Calories</dd>

                                        <dt class="col-6">Sugar</dt>
                                        <dd class="col-6">@fruit.Sugar g</dd>

                                        <dt class="col-6">Carbs</dt>
                                        <dd class="col-6">@fruit.Carbohydrates g</dd>

                                        <dt class="col-6">Protein</dt>
                                        <dd class="col-6">@fruit.Protein g</dd>

                                        <dt class="col-6">Fat</dt>
                                        <dd class="col-6">@fruit.Fat g</dd>
                                    </dl>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
